# Copy to .env.local and change the values.

# Secret used to sign the rotating QR tokens, sign-in sessions and badges.
APP_SECRET=change-me-to-a-long-random-string

# The address visitors' phones use to reach this server. It is what the QR code encodes.
# Leave empty to auto-detect the PC's LAN IP (e.g. http://192.168.0.111:3000).
# In production this is your public HTTPS domain, e.g. https://visit.example.com
PUBLIC_BASE_URL=

# --- Notifications (FR-NOT-01/02/06, FR-PRE-02) ---
# Leave these empty in dev: messages are printed in the terminal running `npm run dev` instead.

# Email via SendGrid (https://sendgrid.com). EMAIL_FROM must be a sender you verified in SendGrid.
SENDGRID_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=Acme Reception

# SMS via Twilio (https://twilio.com). TWILIO_FROM is your Twilio phone number, e.g. +15551234567.
# On a Twilio trial account, SMS only reach numbers you have verified in the Twilio console.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Added in front of phone numbers typed without a country code (SMS needs +<country><number>).
DEFAULT_COUNTRY_CODE=+91
